{
  "manifest_version": 3,
  "name": "LMS Guardian",
  "version": "0.7.1",
  "description": "Your LMS Guardian updates from Moodle and your SIS marks: what's new, deadlines, marks table.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://eng.asu.edu.eg/*",
    "https://lms.eng.asu.edu.eg/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LMS Guardian",
    "default_popup": "dashboard.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lms.eng.asu.edu.eg/*"
      ],
      "js": [
        "lms-theme.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://lms.eng.asu.edu.eg/*"
      ],
      "js": [
        "content-lms.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://eng.asu.edu.eg/*"
      ],
      "js": [
        "content-sis.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html"
      ],
      "matches": [
        "https://lms.eng.asu.edu.eg/*",
        "https://eng.asu.edu.eg/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
