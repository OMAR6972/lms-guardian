{
  "manifest_version": 3,
  "name": "LMS Guardian (standalone)",
  "version": "__VERSION__",
  "description": "Make the Ain Shams Engineering Moodle easier: dark and colour themes, compact layout, phone fixes, not-submitted deadlines, download all files, GPA calculator. Everything stays in your browser.",
  "permissions": ["storage"],
  "host_permissions": ["https://lms.eng.asu.edu.eg/*", "https://eng.asu.edu.eg/*"],
  "content_scripts": [
    { "matches": ["https://lms.eng.asu.edu.eg/*"], "js": ["lms-theme.js"], "run_at": "document_start" },
    { "matches": ["https://lms.eng.asu.edu.eg/*"], "js": ["jszip.min.js", "gpa.js", "gpa-ui.js", "lms-tools.js", "sa-panel.js"], "run_at": "document_idle" },
    { "matches": ["https://eng.asu.edu.eg/*"], "js": ["sis-parse.js", "sa-sis.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
